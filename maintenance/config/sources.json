    {
      "id": "se-skv-belopp",
      "country": "SE",
      "authority": "Skatteverket",
      "type": "html",
      "method": "html-text",
      "category": "income-tax",
      "url": "https://www.skatteverket.se/privat/skatter/beloppochprocent/{year}",
      "yearUrl": "https://www.skatteverket.se/privat/skatter/beloppochprocent/{year}",
      "description": "Amounts and percentages for the income year (price base amount, state-tax threshold, average municipal rate…).",
      "keywords": [
        "kronor",
        "procent"
      ],
      "probes": [
        {
          "id": "pbb",
          "label": "Price base amount",
          "rulePath": "priceBaseAmount",
          "pattern": "Prisbasbeloppet inkomstår \\d{4}: (?<value>[\\d ]+?) kronor",
          "format": "space-thousands",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "ibb",
          "label": "Income base amount",
          "rulePath": "incomeBaseAmount",
          "pattern": "Inkomstbasbeloppet för år \\d{4} har fastställts till (?<value>[\\d ]+?) kronor",
          "format": "space-thousands",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "skiktgrans",
          "label": "State-tax threshold",
          "rulePath": "stateTax.threshold",
          "pattern": "Skiktgränsen för \\d{4} är (?<value>[\\d ]+?) kronor",
          "format": "space-thousands",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "avg-municipal",
          "label": "Average municipal tax rate",
          "rulePath": "average.municipalRate",
          "pattern": "genomsnittliga kommunala skattesatsen för \\d{4} är (?<value>[\\d,]+) procent",
          "format": "decimal-comma",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "pension-fee",
          "label": "General pension fee rate",
          "rulePath": "pensionFee.rate",
          "pattern": "(?<value>\\d+(?:,\\d+)?) procent av förvärvsinkomsten men högst",
          "format": "decimal-comma",
          "scale": 0.01,
          "category": "social"
        }
      ]
    },
    {
      "id": "no-skatteetaten-trinnskatt",
      "country": "NO",
      "authority": "Skatteetaten",
      "type": "html",
      "method": "html-text",
      "category": "income-tax",
      "url": "https://www.skatteetaten.no/satser/trinnskatt/",
      "description": "Bracket tax (trinnskatt) steps and rates.",
      "keywords": [
        "trinn",
        "kroner",
        "%"
      ],
      "yearPattern": "Velg år\\n(?<value>\\d{4})",
      "probes": [
        {
          "id": "t1-threshold",
          "label": "Step 1 threshold",
          "rulePath": "bracketTax.0.threshold",
          "pattern": "For de første (?<value>[\\d ]+?) kronene",
          "format": "space-thousands",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "t2-threshold",
          "label": "Step 2 threshold",
          "rulePath": "bracketTax.1.threshold",
          "pattern": "Trinn 1\\nInntekten mellom [\\d ]+ – (?<value>[\\d ]+?) kroner",
          "format": "space-thousands",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "t3-threshold",
          "label": "Step 3 threshold",
          "rulePath": "bracketTax.2.threshold",
          "pattern": "Trinn 2\\nInntekten mellom [\\d ]+ – (?<value>[\\d ]+?) kroner",
          "format": "space-thousands",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "t4-threshold",
          "label": "Step 4 threshold",
          "rulePath": "bracketTax.3.threshold",
          "pattern": "Trinn 3\\nInntekten mellom [\\d ]+ – (?<value>[\\d ]+?) kroner",
          "format": "space-thousands",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "t5-threshold",
          "label": "Step 5 threshold",
          "rulePath": "bracketTax.4.threshold",
          "pattern": "Trinn 4\\nInntekten mellom [\\d ]+ – (?<value>[\\d ]+?) kroner",
          "format": "space-thousands",
          "scale": 1,
          "category": "income-tax"
        },
        {
          "id": "t1-rate",
          "label": "Step 1 rate",
          "rulePath": "bracketTax.0.rate",
          "pattern": "Trinn 1\\nInntekten mellom [^\\n]+\\n(?<value>[\\d,]+) % trinnskatt",
          "format": "decimal-comma",
          "scale": 0.01,
          "category": "income-tax"
        },
        {
          "id": "t2-rate",
          "label": "Step 2 rate",
          "rulePath": "bracketTax.1.rate",
          "pattern": "Trinn 2\\nInntekten mellom [^\\n]+\\n(?<value>[\\d,]+) % trinnskatt",
          "format": "decimal-comma",
          "scale": 0.01,
          "category": "income-tax"
        },
        {
          "id": "t3-rate",
          "label": "Step 3 rate",
          "rulePath": "bracketTax.2.rate",
          "pattern": "Trinn 3\\nInntekten mellom [^\\n]+\\n(?<value>[\\d,]+) % trinnskatt",
          "format": "decimal-comma",
          "scale": 0.01,
          "category": "income-tax"
        },
        {
          "id": "t4-rate",
          "label": "Step 4 rate",
          "rulePath": "bracketTax.3.rate",
          "pattern": "Trinn 4\\nInntekten mellom [^\\n]+\\n(?<value>[\\d,]+) % trinnskatt",
          "format": "decimal-comma",
          "scale": 0.01,
          "category": "income-tax"
        },
        {
          "id": "t5-rate",
          "label": "Step 5 rate",
          "rulePath": "bracketTax.4.rate",
          "pattern": "Trinn 5\\nInntekten fra og med [^\\n]+\\n(?<value>[\\d,]+) % trinnskatt",
          "format": "decimal-comma",
          "scale": 0.01,
          "category": "income-tax"
        }
      ]
    },
